# Google Identity Services OAuth 2.0 Client ID
# Obtain from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web application)
# Set Authorized JavaScript origins to:
#   - http://localhost:5173
#   - http://127.0.0.1:5173
#
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
